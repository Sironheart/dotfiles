{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["rules/*.md"],
  "update": "disable",
  "plugins": [
    {
      "package": "@eleboucher/opencode-memini-v2",
      "options": { "base_url": "https://memini.siron.casa/" }
    },
    {
      "package": "@dietrichgebert/ponytail"
    }
  ],
  "shell": "fish",
  "lsp": true,
  "formatter": true,
  "mcp": {
    "servers": {
      "mise": {
        "type": "local",
        "command": ["mise", "mcp"]
      }
    }
  },
  "experimental": {
    "background_compaction": true,
    "media_blob": true,
    "portable_shell_scanner": true,
    "subagent_depth": 2,
    "todo": true
  }
}
